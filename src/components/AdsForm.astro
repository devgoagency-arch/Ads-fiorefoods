---
// src/components/AdsForm.astro
// Form component for Google Ads landing page - Canadian B2B retail catalog request
---

<div id="ads-preorder" class="bg-white rounded-3xl p-4 md:p-6 shadow-sm border border-cream">
  <div class="text-center mb-4 md:mb-6">
    <p class="font-rob font-medium text-sm tracking-[.2em] uppercase mb-1" style="color:#acb370">Exclusive Access</p>
    <h2 class="font-cap text-lg md:text-xl lg:text-2xl text-brand" style="color:#80131d">Contact Specialty Food Experts</h2>
    <p class="font-rob text-[11px] md:text-xs text-gray-500 mt-1">Get wholesale catalog, pricing, and stock details within 24 business hours.</p>
  </div>

  <form id="ads-order-form" class="space-y-3 md:space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">
      <!-- 1. BUSINESS NAME * -->
      <div class="flex flex-col gap-0.5 md:gap-1 md:col-span-2">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Business Name <span style="color:#80131d">*</span></label>
        <input id="ads-f-business-name" name="business_name" type="text" required placeholder="Enter business name" class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all">
      </div>

      <!-- 2. CONTACT NAME * -->
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Name <span style="color:#80131d">*</span></label>
        <input id="ads-f-first-name" name="first_name" type="text" required placeholder="Jane" class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all">
      </div>
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Last name <span style="color:#80131d">*</span></label>
        <input id="ads-f-last-name" name="last_name" type="text" required placeholder="Smith" class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all">
      </div>

      <!-- 3. BUSINESS EMAIL * -->
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Business Email <span style="color:#80131d">*</span></label>
        <input id="ads-f-business-email" name="business_email" type="email" required placeholder="name@company.com" class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all">
      </div>

      <!-- 4. PROVINCE * (Ontario selected by default) -->
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Province <span style="color:#80131d">*</span></label>
        <div class="relative">
          <select id="ads-f-province" name="province" required class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all appearance-none bg-white pr-8">
            <option value="" disabled>Select province...</option>
            <option value="Ontario" selected>Ontario</option>
            <option value="Quebec">Quebec</option>
            <option value="British Columbia">British Columbia</option>
            <option value="Alberta">Alberta</option>
            <option value="Manitoba">Manitoba</option>
            <option value="Saskatchewan">Saskatchewan</option>
            <option value="Nova Scotia">Nova Scotia</option>
            <option value="New Brunswick">New Brunswick</option>
            <option value="Newfoundland and Labrador">Newfoundland and Labrador</option>
            <option value="Prince Edward Island">Prince Edward Island</option>
            <option value="Northwest Territories">Northwest Territories</option>
            <option value="Yukon">Yukon</option>
            <option value="Nunavut">Nunavut</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>

      <!-- 5. BUSINESS TYPE * -->
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Business Type <span style="color:#80131d">*</span></label>
        <div class="relative">
          <select id="ads-f-business-type" name="business_type" required class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all appearance-none bg-white pr-8">
            <option value="" disabled selected>Select type...</option>
            <option>Specialty Food Store</option>
            <option>Restaurant / Café</option>
            <option>Cheese Shop</option>
            <option>Online Market</option>
            <option>Hotel / Hospitality</option>
            <option>Supermarket / Grocery</option>
            <option>Distributor / Wholesale</option>
            <option>Other</option>
          </select>
          <svg class="absolute right-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </div>
      </div>

      <!-- 6. BUSINESS WEBSITE (Optional) -->
      <div class="flex flex-col gap-0.5 md:gap-1">
        <label class="font-rob text-[11px] md:text-xs font-medium uppercase tracking-wide" style="color:#1a1a1a">Business Website</label>
        <input id="ads-f-business-website" name="business_website" type="text" placeholder="www.yourwebsite.com" class="fld w-full border border-gray-200 rounded-full px-3 py-1.5 md:py-2 text-xs md:text-sm font-rob transition-all">
      </div>
    </div>

    <div class="mt-4 md:mt-5 text-center">
      <!-- Lead attribution hidden fields -->
      <input id="ads-f-gclid" name="gclid" type="hidden" value="" />
      <input id="ads-f-utm-source" name="utm_source" type="hidden" value="" />
      <input id="ads-f-utm-medium" name="utm_medium" type="hidden" value="" />
      <input id="ads-f-utm-campaign" name="utm_campaign" type="hidden" value="" />
      <input id="ads-f-utm-term" name="utm_term" type="hidden" value="" />
      <input id="ads-f-utm-content" name="utm_content" type="hidden" value="" />
      <input id="ads-f-landing-page" name="landing_page" type="hidden" value="" />

      <!-- Consent checkbox linking to privacy policy -->
      <div class="mb-3 flex items-center justify-center">
        <label class="font-rob text-[11px] md:text-xs text-gray-600 flex items-center gap-2">
          <input id="ads-f-privacy" name="privacy_consent" type="checkbox" class="h-3.5 w-3.5" />
          <span>I agree to the <a href="/privacy-policy" class="text-brand hover:underline open-privacy-modal">Privacy Policy</a></span>
        </label>
      </div>

      <!-- Cloudflare Turnstile container -->
      <div
        id="cf-turnstile-widget"
        class="cf-turnstile mb-2 md:mb-3 flex justify-center"
        data-sitekey="0x4AAAAAADT3pQj5vkuU0Bn1"
        data-action="contact-request"
        data-callback="onTurnstileSuccess"
        data-error-callback="onTurnstileError"
      ></div>
      
      <button type="submit" class="btn btn-red px-8 py-2.5 md:py-3 font-cap text-xs md:text-sm w-full sm:w-auto">
        Request Our Wholesale Catalogue
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
        </svg>
      </button>
      
      <p class="text-gray-400 text-[11px] mt-2 font-rob">
        We'll reply within 24 business hours
      </p>
    </div>
  </form>
</div>

<script is:inline>
  // ── Turnstile widget lifecycle ─────────────────────────────────────────────
  // widgetId is set by data-callback once the widget renders.
  var _turnstileWidgetId = null;

  // Called by Turnstile on successful challenge (data-callback)
  window.onTurnstileSuccess = function(token) {
    // token is automatically placed in the hidden cf-turnstile-response input
    // We only need to capture the widgetId for later reset
    _turnstileWidgetId = window.turnstile.getWidgetId
      ? window.turnstile.getWidgetId(document.getElementById('cf-turnstile-widget'))
      : null;
  };

  // Called by Turnstile on error (data-error-callback)
  window.onTurnstileError = function() {
    const btn = document.getElementById('ads-order-form')?.querySelector('button[type="submit"]');
    if (btn) {
      btn.disabled = false;
      btn.style.opacity = '1';
      btn.style.cursor = 'pointer';
    }
  };

  // ── Lead attribution capture (URL -> sessionStorage -> hidden inputs) ──────
  var ATTR_STORAGE_KEY = 'fiore_ads_attr';
  var ATTR_URL_PARAMS = [
    'gclid',
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_term',
    'utm_content'
  ];
  var ATTR_INPUT_IDS = {
    gclid: 'ads-f-gclid',
    utm_source: 'ads-f-utm-source',
    utm_medium: 'ads-f-utm-medium',
    utm_campaign: 'ads-f-utm-campaign',
    utm_term: 'ads-f-utm-term',
    utm_content: 'ads-f-utm-content',
    landing_page: 'ads-f-landing-page'
  };
  var _memoryAttrFallback = null;

  function readStoredAttribution() {
    var base = {
      gclid: '',
      utm_source: '',
      utm_medium: '',
      utm_campaign: '',
      utm_term: '',
      utm_content: '',
      landing_page: ''
    };
    try {
      var raw = window.sessionStorage.getItem(ATTR_STORAGE_KEY);
      if (raw) {
        var parsed = JSON.parse(raw);
        if (parsed && typeof parsed === 'object') {
          Object.keys(base).forEach(function(key) {
            if (typeof parsed[key] === 'string') {
              base[key] = parsed[key];
            }
          });
        }
      }
      return base;
    } catch (e) {
      if (_memoryAttrFallback) {
        Object.keys(base).forEach(function(key) {
          if (typeof _memoryAttrFallback[key] === 'string') {
            base[key] = _memoryAttrFallback[key];
          }
        });
      }
      return base;
    }
  }

  function captureAttribution() {
    var stored = readStoredAttribution();

    if (!stored.landing_page) {
      stored.landing_page = window.location.href || '';
    }

    var params = new URLSearchParams(window.location.search);
    ATTR_URL_PARAMS.forEach(function(param) {
      if (params.has(param)) {
        var val = params.get(param);
        if (val !== null && val !== '') {
          stored[param] = val;
        }
      }
    });

    _memoryAttrFallback = stored;
    try {
      window.sessionStorage.setItem(ATTR_STORAGE_KEY, JSON.stringify(stored));
    } catch (e) {
      // sessionStorage unavailable; _memoryAttrFallback preserves current page values
    }

    return stored;
  }

  function syncAttributionInputs() {
    var attr = readStoredAttribution();
    Object.keys(ATTR_INPUT_IDS).forEach(function(key) {
      var el = document.getElementById(ATTR_INPUT_IDS[key]);
      if (el) {
        el.value = attr[key] || '';
      }
    });
    return attr;
  }

  captureAttribution();
  syncAttributionInputs();

  // ── Form logic ─────────────────────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('ads-order-form');
    if (!form) return;

    syncAttributionInputs();

    // Privacy modal elements
    const privacyModal = document.createElement('div');
    privacyModal.id = 'privacy-modal';
    privacyModal.className = 'hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60';
    privacyModal.innerHTML = `
      <div class="bg-white rounded-3xl w-full max-w-3xl max-h-[90vh] overflow-y-auto p-6 relative">
        <button id="privacy-modal-close" type="button" class="absolute top-4 right-4 text-gray-500 hover:text-gray-800">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\" stroke-width=\"2\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M6 18L18 6M6 6l12 12\"/>\n          </svg>\n        </button>
        <div id="privacy-modal-content" class="prose text-sm text-gray-700"></div>
      </div>
    `;
    document.body.appendChild(privacyModal);

    const modalContent = document.getElementById('privacy-modal-content');
    const modalCloseBtn = document.getElementById('privacy-modal-close');

    async function openPrivacyModal(url) {
      try {
        modalContent.innerHTML = '<p class="text-center text-sm text-gray-500">Loading…</p>';
        privacyModal.classList.remove('hidden');
        const res = await fetch(url, { credentials: 'same-origin' });
        const text = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(text, 'text/html');
        const main = doc.querySelector('main');
        // Prefer the inner main content, fallback to body
        modalContent.innerHTML = main ? main.innerHTML : doc.body.innerHTML;
        // Scroll to top of modal content
        privacyModal.scrollTop = 0;
      } catch (err) {
        modalContent.innerHTML = '<p class="text-sm text-red-500">Could not load Privacy Policy.</p>';
        console.error('Failed to load privacy policy:', err);
      }
    }

    function closePrivacyModal() {
      privacyModal.classList.add('hidden');
      modalContent.innerHTML = '';
    }

    // Event delegation for links that should open the modal
    document.querySelectorAll('.open-privacy-modal').forEach((el) => {
      el.addEventListener('click', (ev) => {
        ev.preventDefault();
        openPrivacyModal(el.href);
      });
    });

    // Close handlers
    modalCloseBtn?.addEventListener('click', closePrivacyModal);
    privacyModal.addEventListener('click', (e) => { if (e.target === privacyModal) closePrivacyModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !privacyModal.classList.contains('hidden')) closePrivacyModal(); });

    // ── Helper: reset Turnstile widget ──────────────────────────────────────
    function resetTurnstile() {
      if (window.turnstile) {
        try {
          if (_turnstileWidgetId !== null) {
            window.turnstile.reset(_turnstileWidgetId);
          } else {
            // Fallback: reset by element
            window.turnstile.reset(document.getElementById('cf-turnstile-widget'));
          }
        } catch (e) {
          console.warn('Turnstile reset failed:', e);
        }
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const attr = syncAttributionInputs();

      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
        submitBtn.style.cursor = 'not-allowed';
      }

      // Read Turnstile token (placed by the widget into a hidden input)
      const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value;

      const consentChecked = document.getElementById('ads-f-privacy')?.checked;
      if (!consentChecked) {
        alert('Please accept the Privacy Policy to continue.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
          submitBtn.style.cursor = 'pointer';
        }
        return;
      }

      const payload = {
        businessName: document.getElementById('ads-f-business-name').value.trim(),
        firstName: document.getElementById('ads-f-first-name').value.trim(),
        lastName: document.getElementById('ads-f-last-name').value.trim(),
        businessEmail: document.getElementById('ads-f-business-email').value.trim(),
        province: document.getElementById('ads-f-province').value,
        businessType: document.getElementById('ads-f-business-type').value,
        businessWebsite: document.getElementById('ads-f-business-website').value.trim(),
        gclid: document.getElementById('ads-f-gclid')?.value ?? attr.gclid ?? '',
        utm_source: document.getElementById('ads-f-utm-source')?.value ?? attr.utm_source ?? '',
        utm_medium: document.getElementById('ads-f-utm-medium')?.value ?? attr.utm_medium ?? '',
        utm_campaign: document.getElementById('ads-f-utm-campaign')?.value ?? attr.utm_campaign ?? '',
        utm_term: document.getElementById('ads-f-utm-term')?.value ?? attr.utm_term ?? '',
        utm_content: document.getElementById('ads-f-utm-content')?.value ?? attr.utm_content ?? '',
        landing_page: document.getElementById('ads-f-landing-page')?.value ?? attr.landing_page ?? '',
        turnstile_token: turnstileToken,
        privacy_consent: Boolean(consentChecked),
        timestamp: new Date().toISOString()
      };

      try {
        // POST to our server-side API endpoint (runs siteverify, then forwards to Make.com)
        const response = await fetch('/api/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok && result.ok) {
          form.reset();
          syncAttributionInputs();
          resetTurnstile();

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'ads_form_submit',
            conversionValue: 0.00,
            currency: 'CAD',
            leadSource: 'Google Ads Landing'
          });
          window.dataLayer.push({ event: 'form_success' });

          alert('Your request has been successfully submitted! We will reach out to you shortly.');
        } else {
          // Bot/token failure: reset so user can try again with a fresh token
          resetTurnstile();
          alert('There was a problem submitting your request. Please try again.');
        }
      } catch (error) {
        console.error('Submission error:', error);
        resetTurnstile();
        alert('There was a network problem. Please check your connection and try again.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
          submitBtn.style.cursor = 'pointer';
        }
      }
    });
  });
</script>

